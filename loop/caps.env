# The caps of one loop run. loop/loop.ts reads this file.
# A run that reaches a cap exits 1 and a human decides what is next.

# Builder passes in one run.
MAX_PASSES=1

# Passes in a row that do not lower the failing count.
PLATEAU=3

# Wall clock of the whole run.
MAX_MINUTES=120

# Wall clock of one builder pass. A pass that is longer is stopped.
PASS_MINUTES=30
