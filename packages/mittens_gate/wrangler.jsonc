{
  // Not a deployable Worker. This file exists so `wrangler types` can generate
  // the workerd runtime types (WorkerLoader, Fetcher) that the typecheck needs,
  // and so the tests of this package run inside workerd with the same settings.
  "name": "mittens-gate",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"]
}
